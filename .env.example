# Copy this file to .env and fill in your keys. .env is gitignored.

# Anthropic — powers the Olympus chat panel.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Finnhub — market index quotes. https://finnhub.io/register
FINNHUB_API_KEY=

# FRED — treasury rates. https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
