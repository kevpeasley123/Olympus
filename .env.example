# Copy this file to .env and fill in your keys. .env is gitignored.

# Anthropic — powers the Olympus chat panel.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# FRED — treasury and mortgage rates. https://fred.stlouisfed.org/docs/api/api_key.html
# Index quotes come from the Yahoo Finance chart API and need no key.
FRED_API_KEY=
