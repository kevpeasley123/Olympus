# Copy this file to .env and fill in your keys. .env is gitignored.
# Keys are read only by the Rust process; the webview never sees them.

# Required: OpenAI — primary chat and voice reasoning (Sol, Astra), Realtime
# voice, Communications analysis and the Research / Verification agents.
OPENAI_API_KEY=

# Optional: Anthropic — the explicit Claude comparison route. When set, it is
# also passed to Claude Code for delegated coding runs.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
